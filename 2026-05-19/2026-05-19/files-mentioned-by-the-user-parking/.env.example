# VayAccess On-Site Agent — .env template
# Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit credentials.

# ─── Required ──────────────────────────────────────────────────────────

# Postgres connection string. Examples:
#   Neon:   postgresql+psycopg2://USER:PASS@HOST/DB?sslmode=require&channel_binding=require
#   Local:  postgresql+psycopg2://parkops_user:parkops_secret_2026@localhost:5432/parkops_db
#   SQLite: sqlite:///parking.db
DATABASE_URL=

# Cloud portal that receives UHF events + frame stream from this PC.
CLOUD_PUSH_URL=https://vayaccess-cloud.onrender.com

# Bearer token shared with Render (must match Render's CLOUD_PUSH_TOKEN env var).
# Generate a fresh one with:
#   [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
CLOUD_PUSH_TOKEN=

# ─── Optional (defaults shown) ────────────────────────────────────────

# Set to 1 to run the admin/reports API only (no camera, no ML, no USB reader).
# Use this on Render/Fly/Koyeb free tiers and any host without local hardware.
CLOUD_MODE=0

# Video push rate to cloud. 10 fps = ~2 Mbps outbound at quality 60.
CLOUD_STREAM_FPS=10

# JPEG quality 20-95. 60 ≈ 25 KB/frame at 640x360. Lower = less bandwidth
# but plates get blocky below 40.
CLOUD_STREAM_JPEG_Q=60

# Off by default. Set to 1 only when debugging camera aim / OCR failures —
# writes 2 HD JPEGs to disk every 10 s.
DEBUG_SNAPSHOTS=0

# Hardware IPs on the local LAN. Change if your site uses different addressing.
CAMERA_IP=192.168.1.12
RFID_READER_IP=192.168.0.200

# Flask session cookie signing key. Not critical for the on-site agent
# (which doesn't serve UI to remote browsers) but Flask will complain
# if unset. Any random string works.
SECRET_KEY=changeme_random_string_for_flask_sessions
