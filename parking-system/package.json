{
  "name": "vay-parking-system",
  "version": "1.0.0",
  "description": "Smart Parking Management System with Admin and User Dashboards",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "admin": "node admin-server.js",
    "user": "node user-server.js",
    "dev:admin": "nodemon admin-server.js",
    "dev:user": "nodemon user-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:admin\" \"npm run dev:user\"",
    "seed": "node utils/seedDatabase.js",
    "migrate": "node utils/migrate.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.8.7",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
