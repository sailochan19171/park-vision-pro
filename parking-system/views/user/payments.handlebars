        }
    } catch (error) {
        console.error('Error viewing transaction:', error);
        showAlert('Error loading transaction details: ' + error.message, 'danger');
    }
}

async function retryPayment(transactionId) {
    if (confirm('Are you sure you want to retry this payment?')) {
        try {
            showAlert('Retrying payment...', 'info');
            
            const response = await fetch(`http://localhost:3000/api/user/payments/${transactionId}/retry`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    method: 'upi',
                    amount: 150
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                showAlert(`Payment retry successful! New Transaction ID: ${result.data.newTransactionId}`, 'success');
                
                // Refresh payments to show updated status
                setTimeout(() => {
                    refreshPayments();
                }, 1000);
            } else {
                showAlert('Payment retry failed: ' + result.message, 'danger');
            }
        } catch (error) {
            console.error('Error retrying payment:', error);
            showAlert('Error retrying payment: ' + error.message, 'danger');
        }
    }
}

let currentPage = 1;
let isLoading = false;

async function loadMoreTransactions() {
    if (isLoading) return;
    
    try {
        isLoading = true;
        showAlert('Loading more transactions...', 'info');
        
        const search = document.getElementById('transactionSearch').value;
        const status = document.getElementById('statusFilter').value;
        const type = document.getElementById('typeFilter').value;
        
        const params = new URLSearchParams({
            page: currentPage + 1,
            limit: 10,
            ...(search && { search }),
            ...(status && status !== 'all' && { status }),
            ...(type && type !== 'all' && { type })
        });
        
        const response = await fetch(`http://localhost:3000/api/user/payments/transactions?${params}`);
        const result = await response.json();
        
        if (result.success) {
            const transactions = result.data.transactions;
            const pagination = result.data.pagination;
            
            if (transactions.length > 0) {
                // Add new transactions to the existing table
                const tableBody = document.querySelector('#transactionHistory tbody');
                
                transactions.forEach(transaction => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td><strong>${transaction.id}</strong></td>
                        <td>${transaction.type}</td>
                        <td><strong>₹${transaction.amount}</strong></td>
                        <td>
                            <span class="badge bg-${transaction.status === 'completed' ? 'success' : transaction.status === 'pending' ? 'warning' : 'danger'}">
                                ${transaction.status}
                            </span>
                        </td>
                        <td>${new Date(transaction.date).toLocaleDateString()}</td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewTransaction('${transaction.id}')">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="downloadReceipt('${transaction.id}')">
                                    <i class="bi bi-download"></i>
                                </button>
                                ${transaction.status === 'failed' ? `
                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="retryPayment('${transaction.id}')">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                ` : ''}
                            </div>
                        </td>
                    `;
                    tableBody.appendChild(row);
                });
                
                currentPage = pagination.currentPage;
                
                // Hide load more button if no more pages
                if (!pagination.hasMore) {
                    const loadMoreBtn = document.querySelector('button[onclick="loadMoreTransactions()"]');
                    if (loadMoreBtn) {
                        loadMoreBtn.style.display = 'none';
                    }
                }
                
                showAlert(`Loaded ${transactions.length} more transactions`, 'success');
            } else {
                showAlert('No more transactions to load', 'info');
            }
        } else {
            showAlert('Failed to load more transactions: ' + result.message, 'danger');
        }
    } catch (error) {
        console.error('Error loading more transactions:', error);
        showAlert('Error loading more transactions: ' + error.message, 'danger');
    } finally {
        isLoading = false;
    }
}

function showAlert(message, type = 'info') {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1055; min-width: 300px;';
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alertDiv);
    
    setTimeout(() => {
        if (alertDiv.parentElement) {
            alertDiv.remove();
        }
    }, 5000);
}

