<script>
// Payment management functions
async function refreshPayments() {
    console.log('Refreshing payment history...');
    showAlert('Refreshing payment data...', 'info');
    
    try {
        // Reset pagination
        currentPage = 1;
        
        // Fetch payment history and initial transactions
        const [historyResponse, transactionsResponse] = await Promise.all([
            fetch('http://localhost:3000/api/user/payments/history'),
            fetch('http://localhost:3000/api/user/payments/transactions?page=1&limit=10')
        ]);
        
        const historyData = await historyResponse.json();
        const transactionsData = await transactionsResponse.json();
        
        if (historyData.success && transactionsData.success) {
            updatePaymentStats(historyData.data);
            updatePaymentTransactions(transactionsData.data.transactions);
            
            // Show/hide load more button based on pagination
            const loadMoreBtn = document.querySelector('button[onclick="loadMoreTransactions()"]');
            if (loadMoreBtn) {
                loadMoreBtn.style.display = transactionsData.data.pagination.hasMore ? 'block' : 'none';
            }
            
            showAlert('Payments refreshed successfully!', 'success');
        } else {
            throw new Error(historyData.message || transactionsData.message || 'Failed to fetch payment data');
        }
    } catch (error) {
        console.error('Error refreshing payments:', error);
        showAlert('Error refreshing payments: ' + error.message, 'danger');
    }
}

function updatePaymentStats(data) {
    document.getElementById('totalSpent').textContent = `₹${data.totalSpent.toLocaleString()}`;
    document.getElementById('monthlySpent').textContent = `₹${data.monthlySpent.toLocaleString()}`;
    document.getElementById('lastPayment').textContent = `₹${data.lastPayment}`;
    document.getElementById('pendingAmount').textContent = `₹${data.pending}`;
}

function updatePaymentTransactions(transactions) {
    console.log('Updating transactions table with:', transactions);
    
    const tableBody = document.querySelector('#transactionHistory tbody');
    if (!tableBody) {
        console.error('Transaction table body not found');
        return;
    }
    
    // Clear existing rows
    tableBody.innerHTML = '';
    
    // Add new transactions
    transactions.forEach(transaction => {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><strong>${transaction.id}</strong></td>
            <td>${transaction.type}</td>
            <td><strong>₹${transaction.amount}</strong></td>
            <td>
                <span class="badge bg-${transaction.status === 'completed' ? 'success' : transaction.status === 'pending' ? 'warning' : transaction.status === 'refunded' ? 'info' : 'danger'}">
                    ${transaction.status}
                </span>
            </td>
            <td>${new Date(transaction.date).toLocaleDateString()}</td>
            <td>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewTransaction('${transaction.id}')" title="View Details">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="downloadReceipt('${transaction.id}')" title="Download Receipt">
                        <i class="bi bi-download"></i>
                    </button>
                    ${transaction.status === 'failed' ? `
                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="retryPayment('${transaction.id}')" title="Retry Payment">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    ` : ''}
                </div>
            </td>
        `;
        tableBody.appendChild(row);
    });
    
    // If no transactions, show a message
    if (transactions.length === 0) {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td colspan="6" class="text-center text-muted py-4">
                <i class="bi bi-inbox display-4 d-block mb-2"></i>
                No transactions found
            </td>
        `;
        tableBody.appendChild(row);
    }
}

async function filterPayments() {
    const search = document.getElementById('transactionSearch').value;
    const status = document.getElementById('statusFilter').value;
    const type = document.getElementById('typeFilter').value;
    const dateFrom = document.getElementById('dateFromFilter').value;
    const dateTo = document.getElementById('dateToFilter').value;
    
    console.log('Filtering payments:', { search, status, type, dateFrom, dateTo });
    showAlert('Filtering transactions...', 'info');
    
    try {
        // Reset pagination
        currentPage = 1;
        
        const params = new URLSearchParams({
            page: 1,
            limit: 10,
            ...(search && { search }),
            ...(status && status !== 'all' && { status }),
            ...(type && type !== 'all' && { type })
        });
        
        const response = await fetch(`http://localhost:3000/api/user/payments/transactions?${params}`);
        const result = await response.json();
        
        if (result.success) {
            updatePaymentTransactions(result.data.transactions);
            
            // Show/hide load more button based on pagination
            const loadMoreBtn = document.querySelector('button[onclick="loadMoreTransactions()"]');
            if (loadMoreBtn) {
                loadMoreBtn.style.display = result.data.pagination.hasMore ? 'block' : 'none';
            }
            
            showAlert(`Found ${result.data.pagination.totalRecords} transactions`, 'success');
        } else {
            showAlert('Failed to filter transactions: ' + result.message, 'danger');
        }
    } catch (error) {
        console.error('Error filtering payments:', error);
        showAlert('Error filtering transactions: ' + error.message, 'danger');
    }
}

async function downloadStatement() {
