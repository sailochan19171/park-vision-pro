        const params = new URLSearchParams({
            startDate: dateFrom || '2024-01-01',
            endDate: dateTo || new Date().toISOString().split('T')[0],
            format: 'pdf'
        });
        
        const response = await fetch(`http://localhost:3000/api/user/payments/statement?${params}`);
        const result = await response.json();
        
        if (result.success) {
            showAlert(`Statement generated successfully! ${result.data.recordCount} transactions included.`, 'success');
            
            // Simulate download
            const link = document.createElement('a');
            link.href = '#';
