// Payment type change handler
document.addEventListener('DOMContentLoaded', function() {
    const paymentTypeSelect = document.getElementById('paymentType');
    if (paymentTypeSelect) {
        paymentTypeSelect.addEventListener('change', function() {
            const cardDetails = document.getElementById('cardDetails');
            const upiDetails = document.getElementById('upiDetails');
            const walletDetails = document.getElementById('walletDetails');
            
            // Hide all details
            cardDetails.style.display = 'none';
            upiDetails.style.display = 'none';
            walletDetails.style.display = 'none';
            
            // Show relevant details
            switch(this.value) {
                case 'card':
                    cardDetails.style.display = 'block';
                    break;
                case 'upi':
                    upiDetails.style.display = 'block';
                    break;
                case 'wallet':
                    walletDetails.style.display = 'block';
                    break;
            }
        });
    }
    
    // Format card number input
    const cardNumberInput = document.getElementById('cardNumber');
    if (cardNumberInput) {
        cardNumberInput.addEventListener('input', function() {
            let value = this.value.replace(/\s/g, '').replace(/[^0-9]/gi, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            this.value = formattedValue;
        });
    }
    
    // Format expiry date input
    const expiryDateInput = document.getElementById('expiryDate');
    if (expiryDateInput) {
        expiryDateInput.addEventListener('input', function() {
            let value = this.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.substring(0, 2) + '/' + value.substring(2, 4);
            }
            this.value = value;
        });
    }
    
    initializeChart();
    refreshPayments(); // Load initial data
});

async function addPaymentMethod() {
    const paymentType = document.getElementById('paymentType').value;
    const setAsDefault = document.getElementById('setAsDefault').checked;
    
    if (!paymentType) {
        showAlert('Please select a payment type', 'warning');
        return;
    }
    
    let paymentData = {
        type: paymentType,
        isDefault: setAsDefault
    };
    
    // Collect type-specific data
    switch(paymentType) {
        case 'card':
            const cardNumber = document.getElementById('cardNumber').value;
            const expiryDate = document.getElementById('expiryDate').value;
            const cvv = document.getElementById('cvv').value;
            const holderName = document.getElementById('holderName').value;
            
            if (!cardNumber || !expiryDate || !cvv || !holderName) {
                showAlert('Please fill all card details', 'warning');
                return;
            }
            
            paymentData = {
                ...paymentData,
                cardNumber,
                expiryDate,
                cvv,
                holderName
            };
            break;
            
        case 'upi':
            const upiId = document.getElementById('upiId').value;
            if (!upiId) {
                showAlert('Please enter UPI ID', 'warning');
                return;
            }
            paymentData.upiId = upiId;
            break;
            
        case 'wallet':
            const walletProvider = document.getElementById('walletProvider').value;
            const walletId = document.getElementById('walletId').value;
            if (!walletProvider || !walletId) {
                showAlert('Please fill wallet details', 'warning');
                return;
            }
            paymentData.walletProvider = walletProvider;
            paymentData.walletId = walletId;
            break;
    }
    
    try {
        const response = await fetch('http://localhost:3000/api/user/payments/add-method', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(paymentData)
        });
        
        const result = await response.json();
        
        if (result.success) {
            showAlert('Payment method added successfully!', 'success');
            const modal = bootstrap.Modal.getInstance(document.getElementById('addPaymentMethodModal'));
            modal.hide();
            
            // Reset form
            document.getElementById('addPaymentMethodForm').reset();
            document.getElementById('cardDetails').style.display = 'none';
            document.getElementById('upiDetails').style.display = 'none';
            document.getElementById('walletDetails').style.display = 'none';
            
            // Refresh payment methods display
            refreshPayments();
        } else {
            showAlert('Failed to add payment method: ' + result.message, 'danger');
        }
    } catch (error) {
        console.error('Error adding payment method:', error);
        showAlert('Error adding payment method: ' + error.message, 'danger');
    }
}

async function processPayment() {
    const bookingId = document.getElementById('bookingId').value;
    const amount = document.getElementById('paymentAmount').value;
    const method = document.getElementById('selectedPaymentMethod').value;
    const description = document.getElementById('paymentDescription').value;
    
    if (!bookingId || !amount || !method) {
        showAlert('Please fill all required fields', 'warning');
        return;
    }
    
    try {
        showAlert('Processing payment...', 'info');
        
        const response = await fetch('http://localhost:3000/api/user/payments/process', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                bookingId,
                amount: parseFloat(amount),
                method,
                description
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            showAlert('Payment processed successfully! Transaction ID: ' + result.data.transactionId, 'success');
            const modal = bootstrap.Modal.getInstance(document.getElementById('processPaymentModal'));
            modal.hide();
            
            // Reset form
            document.getElementById('processPaymentForm').reset();
            
            // Refresh payments to show new transaction
            setTimeout(() => {
                refreshPayments();
            }, 1000);
        } else {
            showAlert('Payment failed: ' + result.message, 'danger');
        }
    } catch (error) {
        console.error('Error processing payment:', error);
        showAlert('Error processing payment: ' + error.message, 'danger');
    }
}

