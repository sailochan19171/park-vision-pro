// Fix modal accessibility issue
const newBookingModal = document.getElementById('newBookingModal');
if (newBookingModal) {
    newBookingModal.addEventListener('shown.bs.modal', function () {
        // Remove aria-hidden when modal is shown to fix accessibility warning
        this.removeAttribute('aria-hidden');
    });
    
    newBookingModal.addEventListener('hidden.bs.modal', function () {
        // Add aria-hidden back when modal is hidden
        this.setAttribute('aria-hidden', 'true');
    });
}
