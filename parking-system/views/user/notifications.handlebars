<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Notifications</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="markAllAsRead()">
                <i class="bi bi-check-all"></i> Mark All Read
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAll()">
                <i class="bi bi-trash"></i> Clear All
            </button>
        </div>
    </div>
</div>

<!-- Notification Filters -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="btn-group" role="group">
            <input type="radio" class="btn-check" name="notificationFilter" id="all" value="all" checked>
            <label class="btn btn-outline-primary" for="all">All</label>
            
            <input type="radio" class="btn-check" name="notificationFilter" id="unread" value="unread">
            <label class="btn btn-outline-primary" for="unread">Unread</label>
            
            <input type="radio" class="btn-check" name="notificationFilter" id="bookings" value="bookings">
            <label class="btn btn-outline-primary" for="bookings">Bookings</label>
            
            <input type="radio" class="btn-check" name="notificationFilter" id="payments" value="payments">
            <label class="btn btn-outline-primary" for="payments">Payments</label>
        </div>
    </div>
</div>

<!-- Notifications List -->
<div class="card shadow">
    <div class="card-body p-0">
        <div id="notificationsList">
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    loadNotifications();
    
    // Filter change handlers
    document.querySelectorAll('input[name="notificationFilter"]').forEach(radio => {
        radio.addEventListener('change', function() {
            filterNotifications(this.value);
        });
    });
});

function loadNotifications() {
    // Mock notifications data - in real app, this would come from API
    const notifications = [
        {
            id: 1,
            type: 'booking',
            title: 'Booking Confirmed',
            message: 'Your parking booking for spot A002 has been confirmed.',
            timestamp: new Date(Date.now() - 2 * 60 * 60 * 1000), // 2 hours ago
            read: false,
            icon: 'bi-calendar-check',
            color: 'success'
        },
        {
            id: 2,
            type: 'payment',
            title: 'Payment Successful',
            message: 'Payment of ₹100 has been processed successfully.',
            timestamp: new Date(Date.now() - 3 * 60 * 60 * 1000), // 3 hours ago
            read: false,
            icon: 'bi-credit-card',
            color: 'info'
        },
        {
            id: 3,
            type: 'booking',
            title: 'Parking Session Started',
            message: 'Your parking session at Mall Parking has started.',
            timestamp: new Date(Date.now() - 4 * 60 * 60 * 1000), // 4 hours ago
            read: true,
            icon: 'bi-play-circle',
            color: 'primary'
        },
        {
            id: 4,
            type: 'system',
            title: 'Welcome to VayAccess',
            message: 'Thank you for joining VayAccess! Explore our features.',
            timestamp: new Date(Date.now() - 24 * 60 * 60 * 1000), // 1 day ago
            read: true,
            icon: 'bi-heart',
            color: 'warning'
        },
        {
            id: 5,
            type: 'booking',
            title: 'Booking Reminder',
            message: 'Your parking session will end in 30 minutes.',
            timestamp: new Date(Date.now() - 30 * 60 * 1000), // 30 minutes ago
            read: false,
            icon: 'bi-clock',
            color: 'warning'
        }
    ];
    
    renderNotifications(notifications);
    window.allNotifications = notifications; // Store for filtering
}

function renderNotifications(notifications) {
    const container = document.getElementById('notificationsList');
    
    if (!notifications || notifications.length === 0) {
        container.innerHTML = `
            <div class="text-center py-5">
                <i class="bi bi-bell-slash display-1 text-muted"></i>
                <h4 class="mt-3">No Notifications</h4>
                <p class="text-muted">You're all caught up!</p>
            </div>
        `;
        return;
    }
    
    const notificationsHtml = notifications.map(notification => `
        <div class="notification-item ${notification.read ? '' : 'unread'}" data-id="${notification.id}" data-type="${notification.type}">
            <div class="d-flex align-items-start p-3 border-bottom">
                <div class="flex-shrink-0 me-3">
                    <div class="notification-icon bg-${notification.color}">
                        <i class="bi ${notification.icon} text-white"></i>
                    </div>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1 ${notification.read ? '' : 'fw-bold'}">${notification.title}</h6>
                            <p class="mb-1 text-muted">${notification.message}</p>
                            <small class="text-muted">${formatTimeAgo(notification.timestamp)}</small>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" onclick="markAsRead(${notification.id})">
                                    <i class="bi bi-check"></i> Mark as Read
                                </a></li>
                                <li><a class="dropdown-item" href="#" onclick="deleteNotification(${notification.id})">
                                    <i class="bi bi-trash"></i> Delete
                                </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                ${notification.read ? '' : '<div class="unread-indicator"></div>'}
            </div>
        </div>
    `).join('');
    
    container.innerHTML = notificationsHtml;
}

function filterNotifications(filter) {
    const notifications = window.allNotifications || [];
    let filtered = notifications;
    
    switch (filter) {
        case 'unread':
            filtered = notifications.filter(n => !n.read);
            break;
        case 'bookings':
            filtered = notifications.filter(n => n.type === 'booking');
            break;
        case 'payments':
            filtered = notifications.filter(n => n.type === 'payment');
            break;
        default:
            filtered = notifications;
    }
    
    renderNotifications(filtered);
}

function markAsRead(id) {
    const notifications = window.allNotifications || [];
    const notification = notifications.find(n => n.id === id);
    if (notification) {
        notification.read = true;
        renderNotifications(notifications);
        showSuccess('Notification marked as read');
    }
}

function markAllAsRead() {
    const notifications = window.allNotifications || [];
    notifications.forEach(n => n.read = true);
    renderNotifications(notifications);
    showSuccess('All notifications marked as read');
}

function deleteNotification(id) {
    const notifications = window.allNotifications || [];
    const index = notifications.findIndex(n => n.id === id);
    if (index > -1) {
        notifications.splice(index, 1);
        window.allNotifications = notifications;
        renderNotifications(notifications);
        showSuccess('Notification deleted');
    }
}

function clearAll() {
    if (confirm('Are you sure you want to clear all notifications?')) {
        window.allNotifications = [];
        renderNotifications([]);
        showSuccess('All notifications cleared');
    }
}

function formatTimeAgo(date) {
    const now = new Date();
    const diff = now - date;
    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);
    
    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes} minutes ago`;
    if (hours < 24) return `${hours} hours ago`;
    if (days < 7) return `${days} days ago`;
    return date.toLocaleDateString();
}

function showSuccess(message) {
    const alert = document.createElement('div');
    alert.className = 'alert alert-success alert-dismissible fade show position-fixed';
    alert.style.cssText = 'top: 20px; right: 20px; z-index: 9999; max-width: 300px;';
    alert.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alert);
    setTimeout(() => alert.remove(), 3000);
}
</script>

<style>
.notification-item.unread {
    background-color: #f8f9fa;
}

.notification-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.unread-indicator {
    width: 8px;
    height: 8px;
    background-color: #007bff;
    border-radius: 50%;
    margin-left: 10px;
}

.notification-item:hover {
    background-color: #f8f9fa;
}
</style>