<script>
// Dashboard functions
async function refreshDashboard() {
    console.log('Refreshing dashboard data...');
    showAlert('Refreshing dashboard...', 'info');
    
    try {
        const response = await fetch('/api/admin/dashboard', {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
        const data = await response.json();
        
        if (data.success) {
            updateDashboardStats(data.data);
            showAlert('Dashboard updated successfully!', 'success');
        } else {
            throw new Error(data.message || 'Failed to fetch dashboard stats');
        }
    } catch (error) {
        console.error('Error refreshing dashboard:', error);
        showAlert('Error refreshing dashboard: ' + error.message, 'danger');
    }
}

function updateDashboardStats(data) {
    document.getElementById('totalRevenue').textContent = `₹${data.totalRevenue.toLocaleString()}`;
    document.getElementById('activeUsers').textContent = data.activeUsers.toLocaleString();
    document.getElementById('occupiedSpots').textContent = `${data.occupiedSpots} / ${data.totalSpots}`;
    document.getElementById('todayBookings').textContent = data.todayBookings.toString();
    
    // Update occupancy rate display
    const occupancyPercentage = Math.round((data.occupiedSpots / data.totalSpots) * 100);
    const occupancyText = document.querySelector('.card-body small');
    if (occupancyText && occupancyText.textContent.includes('occupancy')) {
        occupancyText.textContent = `${occupancyPercentage}% occupancy rate`;
    }
}

function showAlert(message, type = 'info') {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1055; min-width: 300px;';
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alertDiv);
    
    setTimeout(() => {
        if (alertDiv.parentElement) {
            alertDiv.remove();
        }
    }, 5000);
}

// Initialize revenue chart
function initializeRevenueChart() {
    const canvas = document.getElementById('revenueChart');
    const ctx = canvas.getContext('2d');
    
    // Simple line chart representation (in production, use Chart.js)
    ctx.strokeStyle = '#007bff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(50, 200);
    ctx.lineTo(100, 180);
    ctx.lineTo(150, 160);
    ctx.lineTo(200, 140);
    ctx.lineTo(250, 120);
    ctx.lineTo(300, 100);
    ctx.lineTo(350, 90);
    ctx.stroke();
    
    // Add data points
    ctx.fillStyle = '#007bff';
    [50, 100, 150, 200, 250, 300, 350].forEach(x => {
        ctx.beginPath();
        ctx.arc(x, 200 - (x - 50) * 0.4, 4, 0, 2 * Math.PI);
        ctx.fill();
    });
    
    // Add labels
    ctx.fillStyle = '#333';
    ctx.font = '12px Arial';
    ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'].forEach((month, i) => {
        ctx.fillText(month, 40 + i * 50, 220);
    });
    
    // Add title
    ctx.fillStyle = '#666';
    ctx.font = '14px Arial';
    ctx.fillText('Monthly Revenue Trend', 150, 30);
}

// Real-time updates simulation
function updateRealTimeData() {
    // Simulate real-time data updates
    const occupiedSpots = document.getElementById('occupiedSpots');
    const todayBookings = document.getElementById('todayBookings');
    
    // This would be replaced with actual WebSocket or API calls
    setInterval(() => {
        const currentOccupied = Math.floor(Math.random() * 20) + 170; // Random between 170-190
        occupiedSpots.textContent = `${currentOccupied} / 250`;
        
        const currentBookings = Math.floor(Math.random() * 10) + 85; // Random between 85-95
        todayBookings.textContent = currentBookings.toString();
    }, 10000); // Update every 10 seconds
}

// AI Call Recording Functions
async function loadAICallRecordings() {
    try {
        const response = await fetch('/api/admin/ai-call-recordings', {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            updateAICallAnalytics(result.analytics);
            renderAICallRecordings(result.recordings);
            updateLastSyncTime(result.lastSyncTime);
            
            // Store recordings globally for transcript viewing
            window.aiCallRecordings = result.recordings;
        }
    } catch (error) {
        console.error('Failed to load AI call recordings:', error);
        
        // Show empty state
        const container = document.getElementById('aiCallRecordingsContainer');
        if (container) {
            container.innerHTML = `
                <div class="text-center py-4">
                    <i class="bi bi-robot fs-1 text-muted mb-3"></i>
                    <p class="text-muted">No AI call recordings available</p>
                    <button class="btn btn-sm btn-outline-primary" onclick="refreshAICallRecordings()">
                        <i class="bi bi-arrow-clockwise"></i> Try Again
                    </button>
                </div>
            `;
        }
    }
}

function updateAICallAnalytics(analytics) {
    const totalCalls = document.getElementById('totalAICalls');
    const todayCalls = document.getElementById('todayAICalls');
    const avgDuration = document.getElementById('avgAIDuration');
    const completedCalls = document.getElementById('completedAICalls');
    const callCount = document.getElementById('aiCallCount');

    if (totalCalls) totalCalls.textContent = analytics.totalCalls || 0;
    if (todayCalls) todayCalls.textContent = analytics.todayCalls || 0;
    if (avgDuration) avgDuration.textContent = Math.round(analytics.averageDuration || 0) + 's';
    if (completedCalls) completedCalls.textContent = analytics.completedCalls || 0;
    if (callCount) callCount.textContent = (analytics.totalCalls || 0) + ' Calls';
}

function renderAICallRecordings(recordings) {
    const container = document.getElementById('aiCallRecordingsContainer');
    
    if (!container) return;
    
    if (!recordings || recordings.length === 0) {
        container.innerHTML = `
            <div class="text-center py-4">
                <i class="bi bi-robot fs-1 text-muted mb-3"></i>
                <p class="text-muted">No AI call recordings yet</p>
                <small class="text-muted">Recordings will appear here after customers use the AI Call Agent</small>
            </div>
        `;
        return;
    }

    const recordingsHtml = `
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Session</th>
                    <th>Customer</th>
                    <th>Date & Time</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Messages</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                ${recordings.map(recording => `
                    <tr>
                        <td>
                            <code class="text-primary">${recording.sessionId.substring(0, 8)}...</code>
                        </td>
                        <td>
                            <div>
                                <strong>${recording.customerName || 'Anonymous'}</strong>
                                ${recording.customerPhone ? `<br><small class="text-muted">${recording.customerPhone}</small>` : ''}
                            </div>
                        </td>
                        <td>
                            <small>${new Date(recording.startTime).toLocaleString()}</small>
                        </td>
                        <td>
                            <span class="badge bg-secondary">${Math.round(recording.duration || 0)}s</span>
                        </td>
                        <td>
                            <span class="badge bg-${getCallStatusColor(recording.status)}">
                                ${recording.status}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-info">${(recording.conversationHistory || []).length} msgs</span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" onclick="viewCallTranscript('${recording.sessionId}')">
                                <i class="bi bi-eye"></i> View
                            </button>
                        </td>
                    </tr>
                `).join('')}
            </tbody>
        </table>
    `;

    container.innerHTML = recordingsHtml;
}

function getCallStatusColor(status) {
    const colors = {
        'completed': 'success',
        'active': 'warning', 
        'failed': 'danger',
        'initiated': 'info'
    };
    return colors[status] || 'secondary';
}

function updateLastSyncTime(syncTime) {
    const element = document.getElementById('lastSyncTime');
    if (element && syncTime) {
        element.textContent = new Date(syncTime).toLocaleString();
    }
}

async function refreshAICallRecordings() {
    const btn = event?.target?.closest('button');
    if (btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Syncing...';
        btn.disabled = true;
    }

    try {
        // First sync from AI backend
        await fetch('http://localhost:3001/api/admin/sync-call-recordings', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        // Then load the recordings
        await loadAICallRecordings();
        
        if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
        
        // Show success notification using existing function
        const alert = document.createElement('div');
        alert.className = 'alert alert-success alert-dismissible fade show position-fixed';
        alert.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        alert.innerHTML = `
             AI call recordings synced successfully!
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alert);
        setTimeout(() => alert.remove(), 3000);
        
    } catch (error) {
        console.error('Failed to sync AI call recordings:', error);
        
        if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }
}

function viewCallTranscript(sessionId) {
    // Find the recording
    const recordings = window.aiCallRecordings || [];
    const recording = recordings.find(r => r.sessionId === sessionId);
    
    if (!recording || !recording.conversationHistory) {
        alert('Conversation transcript not available');
        return;
    }

    // Create modal with conversation transcript
    const modalHtml = `
        <div class="modal fade" id="transcriptModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                             AI Call Transcript - ${recording.customerName || 'Anonymous'}
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3 p-3 bg-light rounded">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Customer:</strong> ${recording.customerName || 'Anonymous'}<br>
                                    <strong>Phone:</strong> ${recording.customerPhone || 'Not provided'}<br>
                                </div>
                                <div class="col-md-6">
                                    <strong>Duration:</strong> ${Math.round(recording.duration || 0)} seconds<br>
                                    <strong>Status:</strong> ${recording.status}
                                </div>
                            </div>
                            ${recording.summary ? `<div class="mt-2"><strong>Summary:</strong> ${recording.summary}</div>` : ''}
                        </div>
                        <div class="conversation-transcript" style="max-height: 400px; overflow-y: auto;">
                            ${recording.conversationHistory.map(msg => `
                                <div class="d-flex mb-3 ${msg.speaker === 'customer' ? 'justify-content-end' : ''}">
                                    <div class="card ${msg.speaker === 'customer' ? 'bg-primary text-white' : 'bg-light'}" style="max-width: 75%;">
                                        <div class="card-body p-2">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="bi bi-${msg.speaker === 'customer' ? 'person' : 'robot'} me-1"></i>
                                                <small><strong>${msg.speaker === 'customer' ? 'Customer' : 'AI Agent'}</strong></small>
                                                <small class="ms-auto opacity-75">
                                                    ${new Date(msg.timestamp).toLocaleTimeString()}
                                                </small>
                                            </div>
                                            <div>${msg.message}</div>
                                        </div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="exportTranscript('${sessionId}')">
                            <i class="bi bi-download"></i> Export
                        </button>
                    </div>
                </div>
            </div>
        </div>
    `;

    // Remove existing modal
    const existingModal = document.getElementById('transcriptModal');
    if (existingModal) {
        existingModal.remove();
    }

    // Add modal to page
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('transcriptModal'));
    modal.show();
}

function exportTranscript(sessionId) {
    const recordings = window.aiCallRecordings || [];
    const recording = recordings.find(r => r.sessionId === sessionId);
    
    if (!recording) {
        alert('Recording not found');
        return;
    }

    const transcript = `AI CALL TRANSCRIPT
==================

Session ID: ${recording.sessionId}
Customer: ${recording.customerName || 'Anonymous'}
Phone: ${recording.customerPhone || 'Not provided'}  
Start Time: ${new Date(recording.startTime).toLocaleString()}
Duration: ${Math.round(recording.duration || 0)} seconds
Status: ${recording.status}

SUMMARY:
${recording.summary || 'No summary available'}

CONVERSATION:
${recording.conversationHistory.map(msg => 
    `[${new Date(msg.timestamp).toLocaleTimeString()}] ${msg.speaker.toUpperCase()}: ${msg.message}`
).join('\n')}

---
Generated by VayAccess AI Call Agent System`;

    const blob = new Blob([transcript], { type: 'text/plain' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `ai-call-transcript-${sessionId.substring(0, 8)}.txt`;
    document.body.appendChild(a);
    a.click();
    window.URL.revokeObjectURL(url);
    document.body.removeChild(a);
}

// Initialize dashboard
document.addEventListener('DOMContentLoaded', function() {
    initializeRevenueChart();
    updateRealTimeData();
    refreshDashboard(); // Load initial data
    
    // Auto-refresh dashboard every 5 minutes
    setInterval(refreshDashboard, 300000);
    
    // Load AI call recordings
    loadAICallRecordings();
    
    // Set up auto-refresh for AI calls every 2 minutes  
    setInterval(loadAICallRecordings, 120000);
});
</script>
