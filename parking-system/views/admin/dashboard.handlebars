<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    loadDashboardData();
    setupRealTimeUpdates();
});

async function loadDashboardData() {
    try {
        const response = await fetch('/api/admin/dashboard', {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
        
        // Handle authentication errors
        if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
        }
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const result = await response.json();
        
        if (result.success) {
            const data = result.data;
            
            // Update stats cards - check if elements exist
            const totalUsers = document.getElementById('totalUsers');
            const activeBookings = document.getElementById('activeBookings');
            const totalRevenue = document.getElementById('totalRevenue');
            const occupancyRate = document.getElementById('occupancyRate');
            
            if (totalUsers) totalUsers.textContent = data.stats.totalUsers.toLocaleString();
            if (activeBookings) activeBookings.textContent = data.stats.activeBookings.toLocaleString();
            if (totalRevenue) totalRevenue.textContent = '₹' + data.stats.totalRevenue.toLocaleString();
            if (occupancyRate) occupancyRate.textContent = data.stats.occupancyRate + '%';
            
            // Update quick stats - check if elements exist
            const todayBookings = document.getElementById('todayBookings');
            const pendingPayments = document.getElementById('pendingPayments');
            const totalVehicles = document.getElementById('totalVehicles');
            const systemAlerts = document.getElementById('systemAlerts');
            
            if (todayBookings) todayBookings.textContent = data.stats.todayBookings;
            if (pendingPayments) pendingPayments.textContent = data.stats.pendingPayments;
            if (totalVehicles) totalVehicles.textContent = data.stats.totalVehicles.toLocaleString();
            if (systemAlerts) systemAlerts.textContent = data.stats.systemAlerts;
            
            // Update recent activity - check if element exists
            const recentActivity = document.getElementById('recentActivity');
            if (recentActivity && data.recentActivity) {
                const activityHtml = data.recentActivity.map(activity => `
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3">
                            <div class="bg-${getActivityColor(activity.type)} rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                <i class="bi bi-${getActivityIcon(activity.type)} text-white"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <div class="small fw-bold">${activity.user}</div>
                            <div class="small text-muted">${activity.action}</div>
                        </div>
                        <div class="small text-muted">${activity.time}</div>
                    </div>
                `).join('');
                
                recentActivity.innerHTML = activityHtml;
            }
            
            // Create activity chart - check if element exists and data available
            const chartElement = document.getElementById('activityChart');
            if (chartElement && data.todayChart) {
                const ctx = chartElement.getContext('2d');
                
                // Destroy existing chart if it exists
                if (window.dashboardChart) {
                    window.dashboardChart.destroy();
                }
                
                window.dashboardChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.todayChart.map(item => item.hour),
                    datasets: [{
                        label: 'Bookings',
                        data: data.todayChart.map(item => item.bookings),
                        borderColor: 'rgb(75, 192, 192)',
                        backgroundColor: 'rgba(75, 192, 192, 0.1)',
                        tension: 0.1
                    }, {
                        label: 'Revenue (₹)',
                        data: data.todayChart.map(item => item.revenue),
                        borderColor: 'rgb(255, 99, 132)',
                        backgroundColor: 'rgba(255, 99, 132, 0.1)',
                        tension: 0.1,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Bookings'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Revenue (₹)'
                            },
                            grid: {
                                drawOnChartArea: false,
                            }
                        }
                    }
                }
            });
            
        } else {
            console.error('Failed to load dashboard data');
        }
    } catch (error) {
        console.error('Error loading dashboard data:', error);
        
        // Show error message to user for all loading elements
        const loadingElements = [
            'totalUsers', 'activeBookings', 'totalRevenue', 'occupancyRate',
            'todayBookings', 'pendingPayments', 'totalVehicles', 'systemAlerts'
        ];
        
        loadingElements.forEach(id => {
            const element = document.getElementById(id);
            if (element && element.textContent === 'Loading...') {
                element.textContent = 'Error';
            }
        });
        
        // Show error notification
        showNotification('Failed to load dashboard data. Please refresh the page.', 'danger');
        
        // Update recent activity with error message
        const recentActivity = document.getElementById('recentActivity');
        if (recentActivity) {
            recentActivity.innerHTML = '<div class="text-center text-danger">Error loading activity data</div>';
        }
    }
}

function getActivityColor(type) {
    const colors = {
        'booking': 'primary',
        'payment': 'success',
        'user': 'info',
        'vehicle': 'warning'
    };
    return colors[type] || 'secondary';
}

function getActivityIcon(type) {
    const icons = {
        'booking': 'calendar-check',
        'payment': 'currency-rupee',
        'user': 'person-plus',
        'vehicle': 'car-front'
    };
    return icons[type] || 'info-circle';
}

function refreshDashboard() {
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Refreshing...';
    btn.disabled = true;
    
    loadDashboardData().then(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
        showNotification('Dashboard refreshed successfully!', 'success');
    });
}

function setupRealTimeUpdates() {
    // Update dashboard every 30 seconds
    setInterval(() => {
        loadDashboardData();
    }, 30000);
}

function showNotification(message, type) {
    // Create a simple notification
    const alert = document.createElement('div');
    alert.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alert.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alert.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(alert);
    
    // Auto remove after 3 seconds
    setTimeout(() => {
        if (alert.parentNode) {
            alert.remove();
        }
    }, 3000);
}
</script>
