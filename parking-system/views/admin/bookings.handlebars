</div>

<style>
    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
    .border-left-info { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
    .text-xs { font-size: 0.7rem; }
    .text-gray-300 { color: #dddfeb !important; }
    .text-gray-800 { color: #5a5c69 !important; }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
let bookingsData = [];
let filteredBookings = [];

document.addEventListener('DOMContentLoaded', function() {
    loadBookingsData();
    setupRealTimeUpdates();
    
    // Load parking spots when modal opens
    const bookingModal = document.getElementById('addBookingModal');
    if (bookingModal) {
        bookingModal.addEventListener('show.bs.modal', loadAvailableParkingSpots);
    }
});

async function loadBookingsData() {
    try {
        const response = await fetch('/api/admin/bookings', {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
        
        // Handle authentication errors
        if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
        }
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const result = await response.json();
        
        if (result.success) {
            
            // Update stats cards - check if elements exist
            const totalBookings = document.getElementById('totalBookings');
            const activeBookings = document.getElementById('activeBookings');
            const todayBookings = document.getElementById('todayBookings');
            const todayRevenue = document.getElementById('todayRevenue');
            
            if (totalBookings) totalBookings.textContent = (result.total || 0).toLocaleString();
            if (activeBookings) activeBookings.textContent = (result.active || 0).toLocaleString();
            if (todayBookings) todayBookings.textContent = (result.todayCount || 0).toLocaleString();
            if (todayRevenue) todayRevenue.textContent = '₹' + (result.todayRevenue || 0).toLocaleString();
            
            // Store bookings data
            bookingsData = result.bookings || [];
            filteredBookings = [...bookingsData];
            
            // Update bookings table
            updateBookingsTable();
            
            // Update recent activity
            updateRecentActivity(result.recentActivity);
            
            // Create bookings chart
            createBookingsChart(result.hourlyData);
            
        } else {
            console.error('Failed to load bookings data');
            showError('Failed to load bookings data');
        }
    } catch (error) {
        console.error('Error loading bookings data:', error);
        showError('Error loading bookings data. Please refresh the page.');
        
        // Show error for all loading elements
        const loadingElements = ['totalBookings', 'activeBookings', 'todayBookings', 'todayRevenue'];
        loadingElements.forEach(id => {
            const element = document.getElementById(id);
            if (element && element.textContent === 'Loading...') {
                element.textContent = 'Error';
            }
        });
    }
}

function updateBookingsTable() {
    const tableBody = document.getElementById('bookingsTableBody');
    if (!tableBody || !filteredBookings) return;
    
    if (filteredBookings.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="10" class="text-center text-muted">No bookings found</td></tr>';
        return;
    }
    
    const tableHtml = filteredBookings.slice(0, 20).map(booking => {
        const statusBadge = getStatusBadge(booking.status);
        const duration = booking.duration || 'N/A';
        
        return `
            <tr>
                <td class="fw-bold">#${booking.id}</td>
                <td>${booking.customerName}</td>
                <td class="d-none d-md-table-cell">${booking.vehicleNumber}</td>
                <td><span class="badge bg-info">${booking.spotId}</span></td>
                <td class="d-none d-lg-table-cell">
                    <small>${new Date(booking.startTime).toLocaleDateString()}<br>
                    ${new Date(booking.startTime).toLocaleTimeString()}</small>
                </td>
                <td class="d-none d-lg-table-cell">
                    <small>${new Date(booking.endTime).toLocaleDateString()}<br>
                    ${new Date(booking.endTime).toLocaleTimeString()}</small>
                </td>
                <td><small>${duration}</small></td>
                <td class="fw-bold">₹${booking.amount}</td>
                <td>${statusBadge}</td>
                <td>
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewBooking('${booking.id}')" title="View Details">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-warning" onclick="editBooking('${booking.id}')" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        ${booking.status === 'active' ? 
                            `<button class="btn btn-sm btn-outline-danger" onclick="cancelBooking('${booking.id}')" title="Cancel">
                                <i class="bi bi-x-circle"></i>
                            </button>` : ''
                        }
                    </div>
                </td>
            </tr>
        `;
    }).join('');
    
    tableBody.innerHTML = tableHtml;
}

function updateRecentActivity(activities) {
    const activityContainer = document.getElementById('recentBookingActivity');
    if (!activityContainer || !activities) return;
    
    const activityHtml = activities.map(activity => `
        <div class="d-flex align-items-center mb-3">
            <div class="me-3">
                <div class="bg-${getActivityColor(activity.type)} rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                    <i class="bi bi-${getActivityIcon(activity.type)} text-white"></i>
                </div>
            </div>
            <div class="flex-grow-1">
                <div class="small fw-bold">${activity.description}</div>
                <div class="small text-muted">${activity.time}</div>
            </div>
        </div>
    `).join('');
    
    activityContainer.innerHTML = activityHtml;
}

function createBookingsChart(hourlyData) {
    try {
        const chartElement = document.getElementById('bookingsChart');
        if (!chartElement || !hourlyData) {
            console.log('Chart element or data not available');
            return;
        }
        
        // Check if Chart.js is loaded
        if (typeof Chart === 'undefined') {
            console.error('Chart.js is not loaded');
            return;
        }
        
        const ctx = chartElement.getContext('2d');
        
        // Destroy existing chart if it exists
        if (window.bookingsChart && typeof window.bookingsChart.destroy === 'function') {
            window.bookingsChart.destroy();
        }
        
        window.bookingsChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: hourlyData.map(item => item.hour),
            datasets: [{
                label: 'Bookings',
                data: hourlyData.map(item => item.bookings),
                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Number of Bookings'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Hour of Day'
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });
    } catch (error) {
        console.error('Error creating bookings chart:', error);
    }
}

function getStatusBadge(status) {
    const badges = {
        'active': '<span class="badge bg-success">Active</span>',
        'completed': '<span class="badge bg-primary">Completed</span>',
        'cancelled': '<span class="badge bg-danger">Cancelled</span>',
        'expired': '<span class="badge bg-secondary">Expired</span>'
    };
    return badges[status.toLowerCase()] || '<span class="badge bg-light">Unknown</span>';
}

function getActivityColor(type) {
    const colors = {
        'booking': 'primary',
        'cancellation': 'danger',
        'completion': 'success',
        'payment': 'info'
    };
    return colors[type] || 'secondary';
}

function getActivityIcon(type) {
    const icons = {
        'booking': 'calendar-plus',
        'cancellation': 'x-circle',
        'completion': 'check-circle',
        'payment': 'currency-rupee'
    };
    return icons[type] || 'info-circle';
}

function filterBookings() {
    const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
    const dateFilter = document.getElementById('dateFilter').value;
    const searchTerm = document.getElementById('searchBooking').value.toLowerCase();
    
    filteredBookings = bookingsData.filter(booking => {
        const statusMatch = !statusFilter || booking.status.toLowerCase() === statusFilter;
        const searchMatch = !searchTerm || 
            booking.customerName.toLowerCase().includes(searchTerm) ||
            booking.vehicleNumber.toLowerCase().includes(searchTerm) ||
            booking.id.toString().includes(searchTerm);
        
        // Add date filtering logic here
        let dateMatch = true;
        if (dateFilter) {
            const bookingDate = new Date(booking.startTime);
            const today = new Date();
            
            switch (dateFilter) {
                case 'today':
                    dateMatch = bookingDate.toDateString() === today.toDateString();
                    break;
                case 'yesterday':
                    const yesterday = new Date(today);
                    yesterday.setDate(yesterday.getDate() - 1);
                    dateMatch = bookingDate.toDateString() === yesterday.toDateString();
                    break;
                // Add more date filters as needed
            }
        }
        
        return statusMatch && searchMatch && dateMatch;
    });
    
    updateBookingsTable();
}

function refreshBookings() {
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Refreshing...';
    btn.disabled = true;
    
    loadBookingsData().then(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
        showNotification('Bookings data refreshed successfully!', 'success');
    });
}

function setupRealTimeUpdates() {
    // Update bookings data every 30 seconds
    setInterval(() => {
        loadBookingsData();
    }, 30000);
}

function viewBooking(bookingId) {
    alert(`View Booking Details: ${bookingId}\n\nThis would show detailed information about the booking.`);
}

function editBooking(bookingId) {
    alert(`Edit Booking: ${bookingId}\n\nThis would open an edit form for the booking.`);
}

function cancelBooking(bookingId) {
    if (confirm(`Are you sure you want to cancel booking #${bookingId}?`)) {
        alert(`Booking #${bookingId} would be cancelled.`);
        // Refresh data after cancellation
        loadBookingsData();
    }
}

async function loadAvailableParkingSpots() {
    try {
        const response = await fetch('/api/admin/parking-spots', {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        const parkingSelect = document.getElementById('parkingSpot');
        
        if (data.success && data.spots) {
            // Clear existing options
            parkingSelect.innerHTML = '<option value="">Select Available Spot</option>';
            
            // Add available spots
            data.spots
                .filter(spot => spot.status === 'available')
                .forEach(spot => {
                    const option = document.createElement('option');
                    option.value = spot.spotNumber;
                    option.textContent = `${spot.spotNumber} - ${spot.location.name} (Floor ${spot.location.floor})`;
                    parkingSelect.appendChild(option);
                });
                
            if (data.spots.filter(spot => spot.status === 'available').length === 0) {
                parkingSelect.innerHTML = '<option value="">No spots available</option>';
            }
        } else {
            // Fallback to known spots
            parkingSelect.innerHTML = `
                <option value="">Select Available Spot</option>
                <option value="BLR-001">BLR-001 - Main Area</option>
                <option value="BLR-002">BLR-002 - Main Area</option>
                <option value="BLR-003">BLR-003 - Main Area</option>
                <option value="MUM-001">MUM-001 - Main Area</option>
                <option value="MUM-002">MUM-002 - Main Area</option>
            `;
        }
    } catch (error) {
        console.error('Error loading parking spots:', error);
        // Use fallback spots
        const parkingSelect = document.getElementById('parkingSpot');
        parkingSelect.innerHTML = `
            <option value="">Select Available Spot</option>
            <option value="BLR-001">BLR-001 - Main Area</option>
            <option value="BLR-002">BLR-002 - Main Area</option>
            <option value="BLR-003">BLR-003 - Main Area</option>
            <option value="MUM-001">MUM-001 - Main Area</option>
            <option value="MUM-002">MUM-002 - Main Area</option>
        `;
    }
}

async function createBooking() {
    const form = document.getElementById('addBookingForm');
    const submitButton = document.querySelector('#addBookingModal .btn-primary');
    
    // Prevent double submissions
    if (submitButton.disabled) return;
    
    if (form.checkValidity()) {
        try {
            // Disable submit button
            submitButton.disabled = true;
            submitButton.innerHTML = '<i class="bi bi-hourglass-split"></i> Creating...';
            
            const formData = {
                customerName: document.getElementById('customerName').value.trim(),
                customerEmail: document.getElementById('customerEmail').value.trim(),
                vehicleNumber: document.getElementById('vehicleNumber').value.trim().toUpperCase(),
                parkingSpot: document.getElementById('parkingSpot').value,
                startDateTime: document.getElementById('startDateTime').value,
                endDateTime: document.getElementById('endDateTime').value
            };
            
            console.log('📝 Submitting booking:', formData);
            
            const response = await fetch('/api/admin/bookings', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });
            
            const data = await response.json();
            
            if (data.success) {
                showNotification('✅ Booking created successfully!', 'success');
                
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('addBookingModal'));
                if (modal) modal.hide();
                
                // Reset form
                form.reset();
                
                // Refresh data
                loadBookingsData();
            } else {
                throw new Error(data.message || 'Failed to create booking');
            }
        } catch (error) {
            console.error('Error creating booking:', error);
            showError('Error creating booking: ' + error.message);
        } finally {
            // Re-enable submit button
            submitButton.disabled = false;
            submitButton.innerHTML = '<i class="bi bi-plus-circle"></i> Create Booking';
        }
    } else {
        form.reportValidity();
    }
}

function showError(message) {
    const alert = document.createElement('div');
    alert.className = 'alert alert-danger alert-dismissible fade show position-fixed';
    alert.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alert.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(alert);
    
    setTimeout(() => {
        if (alert.parentNode) {
            alert.remove();
        }
    }, 5000);
}

function showNotification(message, type) {
    const alert = document.createElement('div');
    alert.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alert.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alert.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(alert);
    
    setTimeout(() => {
        if (alert.parentNode) {
            alert.remove();
        }
    }, 3000);
}
</script>