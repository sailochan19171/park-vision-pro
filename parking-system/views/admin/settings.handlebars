                                    <div class="card">
                                        <div class="card-body text-center">
                                            <i class="bi bi-cloud fa-3x text-success mb-3"></i>
                                            <h6>Cloud Storage</h6>
                                            <p class="text-muted">AWS S3, Google Cloud</p>
                                            <span class="badge bg-success">Connected</span>
